# Public site URL (used for SEO metadata, sitemap and referral links)
NEXT_PUBLIC_SITE_URL=http://localhost:2736

# Supabase — leave empty until the backend is provisioned.
# While empty, login/registration forms stay in "opening soon" mode and
# portal pages show their architecture preview. No data is ever faked.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
